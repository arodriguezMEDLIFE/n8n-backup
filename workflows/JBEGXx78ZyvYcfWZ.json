      },
      {
        "parameters": {
          "jsCode": "const b = $input.first().json.body;\n\n// epoch ms (medianoche UTC de HubSpot) -> \"YYYY-MM-DD\". UTC a propósito:\n// si convirtiera a hora de Lima, las fechas se correrían un día atrás.\nconst toDateUTC = (ms) => {\n  if (ms === null || ms === undefined || ms === \"\") return undefined;\n  const d = new Date(Number(ms));\n  return isNaN(d.getTime()) ? undefined : d.toISOString().slice(0, 10);\n};\nconst toYesNo = (v) => (v === true ? \"Yes\" : v === false ? \"No\" : undefined);\nconst val = (v) =>\n  v === null || v === undefined || v === \"\" ? undefined\n  : typeof v === \"string\" ? v.trim() : v;\n\nif (b.hs_object_id === null || b.hs_object_id === undefined) {\n  throw new Error(\"Payload sin hs_object_id\");\n}\n\n// Header EXACTO del Sheet (con \\n para los saltos de línea) -> valor del payload\nconst candidates = {\n  \"RECORD ID\": String(b.hs_object_id),\n  \"Chapter Info\\nForm\\n(Hubspot)\": toYesNo(b.chapter_info_completed),\n  \"Goals Form\\nCompleted\\n(Hubspot)\": toYesNo(b.chapter_goals_completed),\n  \"Instagram Link\\n(Hubspot)\": val(b.instagram_handle__c),\n  \"School start date\\n(Hubspot)\": toDateUTC(b.first_day_of_class),\n  \"Planning\\n& GSW\\nDate\": toDateUTC(b.n2024_25_gsw_date),\n  \"Club Fair\\n(Hubspot)\": toDateUTC(b.activities_fair_date),\n  \"1st GBM\\n(Hubspot)\": toDateUTC(b.gbm_date),\n  \"Medlife QR Sheet Link\\n(Hubspot)\": val(b.qr_database_url),\n  \"First\\nSLT Season\\n(Hubspot)\": val(b.slt_season_hs),\n  \"First\\nSLT Goal\\n(Hubspot)\": val(b.travelers_goal),\n  \"Second\\nSLT Goal\\n(Hubspot)\": val(b.travelers_goal_2),\n  \"SLT Destination, Date and Season 1\": val(b.slt_destination__date_and_season_hs),\n  \"SLT Destination, Date and Season 2\": val(b.slt_destination_date_and_season_2),\n};\n\n// \"vacío = no tocar\": se omiten las claves undefined (RECORD ID siempre va)\nconst row = {};\nfor (const [k, v] of Object.entries(candidates)) {\n  if (v !== undefined) row[k] = v;\n}\n\nreturn [{ json: row }];"
        },
