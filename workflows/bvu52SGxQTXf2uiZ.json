    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst messageType = 'video';\nconst now = new Date();\nconst timestamp = now.toISOString();\n\nconst channel = 'iform';\nlet mediaUrl = $json[\"body.drive_urls\"];\n\nconst date = new Date(now.getTime() - (5 * 60 * 60 * 1000));\n\nconst uploadedAt = date.toISOString().slice(0, 10);\n\nconst hourMinute =\n  String(date.getUTCHours()).padStart(2, '0') +\n  ':' +\n  String(date.getUTCMinutes()).padStart(2, '0');\n\nconst phone = $('Webhook').item.json.body.volunteer_phone\nconst name = $('Webhook').item.json.body.volunteer_name\n\nreturn {\n  messageType,\n  channel,\n  mediaUrl,\n  uploadedAt,\n  hourMinute,\n  timestamp,\n  phone,\n  name\n};"
      },
