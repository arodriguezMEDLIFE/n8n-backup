        "parameters": {
          "jsCode": "const { createHmac } = require('crypto');\n// Get Webhook Data\nconst webhookData = $('Webhook').all()[0].json\n\n//Format into valid str for validation\nconst str = \"POST\" + webhookData.webhookUrl + JSON.stringify(webhookData.body) + webhookData.headers[\"x-hubspot-request-timestamp\"]\n\n//Creation of signature \nconst signature = createHmac('sha256', $vars.webhook_secret).update(str).digest('base64')\n\n//Validation against the HubSpot Signature\nif (signature !== webhookData.headers[\"x-hubspot-signature-v3\"]) {\n  return {status:\"false\",subject: \"Error during webhook validation\", body: \"We couldn't validate the source of the webhook <br/>Signature used: \"+signature}\n}else{\n return {status:\"true\"}\n}\n\n"
        },
