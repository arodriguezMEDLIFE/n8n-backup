      {
        "parameters": {
          "jsCode": "const { Client } = require(\"@hubspot/api-client\");\n\nconst hubspotClient = new Client({ accessToken: $vars.discount_generator_apikey });\nconsole.log($vars);\nconst discount_key = $(\"Webhook\").all()[0].json.body.discount_property;\nconst properties = {};\nproperties[discount_key] = $(\n  \"add_discount_to_postgres\",\n).all()[0].json.discount_code;\nproperties.trip_url_for_kangaroo =\n  $(\"generate_discount\").all()[0].json.trip_url;\nconst searchResponse = await hubspotClient.crm.contacts.searchApi.doSearch({\n  filterGroups: [\n    {\n      filters: [\n        {\n          value: $(\"add_discount_to_postgres\").all()[0].json.assigned_to,\n          propertyName: \"hs_additional_emails\",\n          operator: \"CONTAINS_TOKEN\",\n        },\n      ],\n    },\n    {\n      filters: [\n        {\n          value: $(\"add_discount_to_postgres\").all()[0].json.assigned_to,\n          propertyName: \"email\",\n          operator: \"EQ\",\n        },\n      ],\n    },\n  ],\n  sorts: [],\n  properties: [],\n  limit: 1,\n  after: 0,\n});\nif (searchResponse.results.length > 0) {\n  console.log(searchResponse.results[0]);\n\n  const apiResponse = await hubspotClient.crm.contacts.basicApi.update(\n    searchResponse.results[0].id,\n    { properties },\n  );\n  return apiResponse;\n} else {\n  throw new Error(\"Contact not found in Hubspot line 37!\");\n}\n"
        },
