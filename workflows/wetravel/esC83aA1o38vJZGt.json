      {
        "parameters": {
          "jsCode": "//Format discount information\nconst discountInformation = $('Webhook').all()[0].json.body\nconst trips = $('get_trip_data').all()\nlet trip_id =\"\"\nlet trip_url =\"\"\n//Find associated trip\nfor(let i of trips){\n  if(discountInformation.trip_id.toString() ===i.json.trip_id){\n    trip_id = i.json.trip_id\n    trip_url = i.json.url\n  }\n}\n\n//Generate random code\nconst crypto = require(\"crypto\");\nfunction randomString(length, chars) {\n  const charsLength = chars.length;\n  const randomBytes = crypto.randomBytes(length);\n  let result = new Array(length);\n  let cursor = 0;\n  for (let i = 0; i < length; i++) {\n    cursor += randomBytes[i];\n    result[i] = chars[cursor % charsLength];\n  }\n  return result.join(\"\");\n}\n\n//Check if kangaroo\nlet tru_amount = 0\nif (discountInformation.discount_property === 'kangaroo_code') {\n  tru_amount = Number(discountInformation.amount) / 10\n} else {\n  tru_amount = Number(discountInformation.amount)\n}\n//Generate body for discount\nconst data = {\n  quantity: 1,\n  discount_type: 'amount',\n  name: randomString(15,'QWERTYUIOPLKJHGFDSAZXCVBNM.-@_'),\n  amount: tru_amount\n}\n\nreturn {data:data, trip_id:trip_id, trip_url:trip_url}"
        },
