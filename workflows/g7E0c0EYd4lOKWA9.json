        "name": "Schedule Trigger"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT\n    ms.booking_id,\n    ms.trip_id,\n    t.sku,\n    t.trip_name,\n    ms.status\nFROM master_sheet ms\nLEFT JOIN all_trips t\n    ON ms.trip_id = t.trip_id\nWHERE\n    ms.starting_date >= CURRENT_DATE + INTERVAL '14 days'\n  AND\n    ms.starting_date <= CURRENT_DATE + INTERVAL '60 days'\n  AND\n    ms.status != 'Cancelled'\n  AND (\n    passport_number IS NULL\n    OR ms.passport_expiry_date IS NULL\n    OR ms.flight_arrival_airline_and_number IS NULL\n    OR ms.flight_arrival_date IS NULL\n    OR ms.flight_arrival_arrival_time IS NULL\n    OR ms.flight_departure_airline_and_number IS NULL\n    OR ms.flight_departure_date IS NULL\n    OR ms.flight_departure_arrival_time IS NULL\n  ) \n  ORDER BY \n    ms.starting_date ASC;\n",
          "options": {}
        },
        "type": "n8n-nodes-base.postgres",
